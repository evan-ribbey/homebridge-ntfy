{
  "name": "@eribbey/homebridge-ntfy",
  "displayName": "Homebridge Ntfy",
  "type": "module",
  "version": "1.2.3",
  "description": "Homebridge plugin to send notifications through ntfy from HomeKit, with support for custom self-hosted servers and authentication",
  "author": "Evan Ribbey",
  "contributors": [
    "Emil Löfblom (https://github.com/emilof)"
  ],
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/evan-ribbey/homebridge-ntfy#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evan-ribbey/homebridge-ntfy.git"
  },
  "bugs": {
    "url": "https://github.com/evan-ribbey/homebridge-ntfy/issues"
  },
  "keywords": [
    "homebridge",
    "homebridge-plugin",
    "ntfy",
    "ntfy-sh",
    "notifications",
    "self-hosted"
  ],
  "main": "dist/index.js",
  "files": [
    "dist",
    "config.schema.json",
    "NOTICE"
  ],
  "engines": {
    "node": "^22 || ^24 || ^26",
    "homebridge": "^2.0.0"
  },
  "scripts": {
    "build": "rimraf ./dist && tsc",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run test && npm run build",
    "watch": "npm run build && npm link && nodemon"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^26.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.0.0",
    "homebridge": "^2.4.0",
    "nodemon": "^3.1.11",
    "rimraf": "^6.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.0",
    "typescript-eslint": "^8.49.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "axios": "^1.21.0"
  },
  "funding": {
    "type": "kofi",
    "url": "https://ko-fi.com/eribbey"
  }
}
